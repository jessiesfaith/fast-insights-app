{
  "name": "ar-tool-beta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AR Tool-Beta — modern glassmorphic AR reconciliation dashboard, single-file build.",
  "scripts": {
    "dev": "vite",
    "dev:fast": "vite --no-open",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "clean": "node -e \"for (const p of ['dist','tsconfig.tsbuildinfo','tsconfig.node.tsbuildinfo','node_modules/.vite']) require('fs').rmSync(p, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "0.460.0",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.15.1",
    "recharts": "2.13.3",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.5"
  }
}
